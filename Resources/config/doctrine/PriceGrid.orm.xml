<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping
        xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                            http://raw.github.com/doctrine/doctrine2/master/doctrine-mapping.xsd">

    <mapped-superclass
            name="Ekyna\Bundle\ProductBundle\Entity\PriceGrid"
            table="product_price_grid">

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <many-to-one target-entity="Ekyna\Bundle\ProductBundle\Model\ProductInterface"
                     field="product" inversed-by="priceGrids">
            <join-column name="product_id" referenced-column-name="id" on-delete="CASCADE" nullable="true"/>
        </many-to-one>

        <many-to-one target-entity="Ekyna\Component\Commerce\Customer\Model\CustomerGroupInterface" field="group">
            <join-column name="customer_group_id" referenced-column-name="id" on-delete="CASCADE" nullable="true" />
        </many-to-one>

        <one-to-many field="rules" target-entity="Ekyna\Bundle\ProductBundle\Model\PriceGridRuleInterface" mapped-by="grid">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>
    </mapped-superclass>

</doctrine-mapping>
