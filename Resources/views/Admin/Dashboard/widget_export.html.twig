{% apply spaceless %}
<div class="commerce-export">
    <div class="commerce-panel">
        <h3>{{ 'stock_analysis.title'|trans({}, 'EkynaProduct') }}</h3>
        <p>
            <a href="{{ path('admin_ekyna_product_stock_analysis_export') }}"
               class="btn btn-sm btn-default">
                <span class="glyphicon glyphicon-download"></span>
                {{- 'button.export'|trans({}, 'EkynaUi') -}}
            </a>
            <a href="{{ path('admin_ekyna_product_stock_analysis_import') }}"
               class="btn btn-sm btn-default">
                <span class="glyphicon glyphicon-download"></span>
                {{- 'button.import'|trans({}, 'EkynaUi') -}}
            </a>
        </p>
    </div>
</div>
{% endapply %}
