<style>
    #sale-browse-products {

    }
    #sale-browse-products header {

    }
    #sale-browse-products > div {
        display: flex;
    }
    #sale-browse-products > div > nav {
        margin-right: 30px;
        min-width: 200px;
    }
    #sale-browse-products > div > nav > ul {
        padding: 0;
        list-style: none;
        font-size: 14px;
        line-height: 28px;
    }
    #sale-browse-products > div > nav > ul ul {
        list-style: square;
        padding: 0 0 0 25px;
        color: darkgrey;
    }
    #sale-browse-products > div > main {
        flex-grow: 1;
    }
    #sale-browse-products > div > main > h1 {
        border-bottom: 1px solid lightgrey;
        margin-bottom: 20px;
        padding-bottom: 10px;
        font-size: 32px;
    }
    #sale-browse-products > div > main > .thumb-list {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 20px;
    }
    #sale-browse-products > div > main > .thumb-list > .thumb {
        flex: 1 30%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 3px 7px 0 rgba(0, 0, 0, 0.2);
        position: relative;
    }
    #sale-browse-products > div > main > .thumb-list > .thumb > p {
        margin: 0;
        padding: 5px 7px;
        background: #ebf3f9;
    }
    #sale-browse-products > div > main > .thumb-list > .thumb > img {
        margin-top: auto;
        max-width: 100%;
    }
    #sale-browse-products > div > main > .thumb-list > .thumb > a {
        position: absolute;
        bottom: 0;
        display: block;
        text-align: center;
        background-color: #337ab7;
        color: white;
        line-height: 32px;
        right: 0;
        width: 70px;
        height: 32px;
        border-radius: 7px 0 0 0;
    }
</style>
<div id="sale-browse-products" data-add-item-path="{{ add_item_path }}">
    <div>
        <nav>
            <ul>
                {% for category in categories %}
                <li>
                    <a href="javascript:void(0)" data-id="{{ category.id }}">
                        {{ category.name }}
                    </a>
                    {% if not category.children.empty %}
                    <ul>
                        {% for child in category.children %}
                        <li>
                            <a href="javascript:void(0)" data-id="{{ child.id }}">
                                {{ child.name }}
                            </a>
                        </li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </nav>

        <main>
            <div>
                <p>Please select a category in the left panel.</p>
            </div>
        </main>
    </div>
</div>
<script type="text/javascript">
    require(['ekyna-product/admin/sale-browse-products'], function (SaleAddProduct) {
        new SaleAddProduct(document.querySelector('#sale-browse-products'));
    });
</script>
